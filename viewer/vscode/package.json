{
  "name": "cantica-agent-status",
  "displayName": "Cantica Agent Status",
  "description": "Live status of the agent sessions on this machine, from the agent-behaviors session-status board.",
  "version": "0.12.0",
  "publisher": "canticatech",
  "icon": "media/icon.png",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/cantica-tech/agent-behaviors"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentStatus.open",
        "title": "Open Agent Status",
        "category": "Agent Status",
        "icon": "$(link-external)"
      },
      {
        "command": "agentStatus.refresh",
        "title": "Refresh",
        "category": "Agent Status",
        "icon": "$(refresh)"
      },
      {
        "command": "agentStatus.openSettings",
        "title": "Settings",
        "category": "Agent Status",
        "icon": "$(settings-gear)"
      },
      {
        "command": "agentStatus.addSkills",
        "title": "Add Skills to Agents",
        "category": "Agent Status"
      }
    ],
    "configuration": {
      "title": "Agent Status",
      "properties": {
        "agentStatus.boardDirectory": {
          "type": "string",
          "default": "",
          "description": "Status board directory. Empty means ~/.agent-behaviors/status."
        },
        "agentStatus.usageScript": {
          "type": "string",
          "default": "",
          "description": "Path to session-status/scripts/usage.py. Empty means the copy bundled with the extension."
        },
        "agentStatus.python": {
          "type": "string",
          "default": "python3",
          "description": "Python 3 interpreter used to run usage.py."
        },
        "agentStatus.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show a summary of the agent sessions in the status bar."
        },
        "agentStatus.chatCommands": {
          "type": "object",
          "description": "Chat that Open session opens, by agent: a key matched (case-insensitive, substring) against the session's agent or model, mapped to the VS Code command that opens its chat. withSession passes the session id so the command reopens that session. Agents without an entry, or whose command is not installed, fall back to a terminal (background Claude Code) or their project folder.",
          "default": {
            "claude": {
              "command": "claude-vscode.editor.open",
              "withSession": true
            },
            "copilot": {
              "command": "workbench.action.chat.open"
            },
            "mistral": {
              "command": "mistral-vibe-code.open"
            },
            "vibe": {
              "command": "mistral-vibe-code.open"
            },
            "codex": {
              "command": "chatgpt.openSidebar"
            }
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "withSession": {
                "type": "boolean"
              }
            },
            "required": [
              "command"
            ]
          }
        },
        "agentStatus.agentsMonitorFolder": {
          "type": "string",
          "default": "~/.agent-behaviors",
          "markdownDescription": "The AgentsMonitor folder. At activation the extension deploys the agent skills it ships (README, LICENSE, `coding/`, `session-status/`) into its `skills/` subfolder, once per extension version. A `skills` folder that is a link (e.g. to a checkout of agent-behaviors) is left alone."
        },
        "agentStatus.viewerBoardSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 300,
          "markdownDescription": "How often the views re-read the board, in seconds, on top of reacting to file changes. Saved to `~/.agent-behaviors/session-status.json`, which every viewer and agent reads; applies at once."
        },
        "agentStatus.viewerUsageSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "maximum": 3600,
          "markdownDescription": "How often token usage is re-measured with usage.py, in seconds. Saved to `~/.agent-behaviors/session-status.json`, which every viewer and agent reads; applies at once."
        },
        "agentStatus.statusSessionSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 60,
          "maximum": 3600,
          "markdownDescription": "Cycle of the <model>.status background session, in seconds. Saved to `~/.agent-behaviors/session-status.json`, which every viewer and agent reads; applies at once."
        },
        "agentStatus.doneVisibleHours": {
          "type": "number",
          "default": 12,
          "minimum": 0,
          "maximum": 720,
          "markdownDescription": "How long a done session stays in the views and reports, in hours. Saved to `~/.agent-behaviors/session-status.json`, which every viewer and agent reads; applies at once."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentStatus",
          "title": "Agent Status",
          "icon": "media/viewer.svg"
        }
      ]
    },
    "views": {
      "agentStatus": [
        {
          "type": "webview",
          "id": "agentStatus.sidebar",
          "name": "Sessions",
          "icon": "media/viewer.svg"
        },
        {
          "id": "agentStatus.summary",
          "name": "Summary",
          "icon": "media/viewer.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "agentStatus.refresh",
          "when": "view == agentStatus.sidebar",
          "group": "navigation"
        },
        {
          "command": "agentStatus.open",
          "when": "view == agentStatus.sidebar",
          "group": "navigation"
        },
        {
          "command": "agentStatus.openSettings",
          "when": "view == agentStatus.sidebar",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "sync": "node scripts/sync.js",
    "vscode:prepublish": "node scripts/sync.js",
    "package": "npx --yes @vscode/vsce@3.2.1 package --no-dependencies --allow-missing-repository --readme-path README.marketplace.md --baseContentUrl https://github.com/cantica-tech/agent-behaviors/blob/main/viewer --baseImagesUrl https://github.com/cantica-tech/agent-behaviors/raw/main/viewer",
    "test": "cd .. && node --test test/",
    "publish": "npx --yes @vscode/vsce@3.2.1 publish --no-dependencies --allow-missing-repository --readme-path README.marketplace.md --baseContentUrl https://github.com/cantica-tech/agent-behaviors/blob/main/viewer --baseImagesUrl https://github.com/cantica-tech/agent-behaviors/raw/main/viewer"
  }
}
